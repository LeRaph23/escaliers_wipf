---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import CatalogLinear from "../components/CatalogLinear.astro";
import GalleryHeritage from "../components/GalleryHeritage.astro";
import SocialProof from "../components/SocialProof.astro";
import VideoEmbed from "../components/VideoEmbed.astro";
import ContactSection from "../components/ContactSection.astro";
import { site } from "../data/site-content.js";
---

<BaseLayout title={site.defaultMeta.title} description={site.defaultMeta.description}>
  <Hero />
  <CatalogLinear />
  <GalleryHeritage />
  <SocialProof />
  <VideoEmbed />
  <ContactSection />
</BaseLayout>
