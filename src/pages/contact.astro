---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact | SOS Elec" description="Contact et demande de devis - SOS Elec">
  <div class="flex min-h-[50vh] flex-col items-center justify-center px-4 py-20 text-center">
    <p class="text-stone-600">Redirection vers la section Contact & devis…</p>
    <a href="/#contact" class="mt-4 font-medium text-amber-700 hover:text-amber-800">Cliquez ici si la redirection ne fonctionne pas</a>
  </div>
  <script is:inline>
    window.location.replace("/#contact");
  </script>
</BaseLayout>
