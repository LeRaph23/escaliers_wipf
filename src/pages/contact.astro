---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact & devis | Escaliers Wipf Olivier" description="Demande de devis - Escaliers Wipf Olivier. Liebsdorf, Sundgau, Haut-Rhin.">
  <div class="flex min-h-[50vh] flex-col items-center justify-center px-4 py-20 text-center">
    <p class="text-[var(--fg)]/80">Redirection vers la section Contact & devis…</p>
    <a href="/#contact" class="mt-4 font-medium text-[var(--accent)] hover:underline">Cliquez ici si la redirection ne fonctionne pas</a>
  </div>
  <script is:inline>
    window.location.replace("/#contact");
  </script>
</BaseLayout>
