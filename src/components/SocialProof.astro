---
import { heritage } from "../data/site-content.js";
const reviews = heritage.clientReviews.slice(0, 3);
---

<section id="avis" class="border-t border-stone-200 py-24" aria-labelledby="avis-heading" style="background-color: rgba(120, 53, 15, 0.08);">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <h2 id="avis-heading" class="font-serif text-4xl font-semibold tracking-tight text-[var(--fg)] md:text-5xl text-center">
      Ce que disent nos clients
    </h2>
    <p class="mt-6 text-center text-[var(--fg)]/80">
      {heritage.googleRating}/5 étoiles sur Google Maps
      {heritage.googleReviewCount > 0 && (
        <span> — {heritage.googleReviewCount} avis</span>
      )}
    </p>

    <ul class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8 list-none p-0 m-0" role="list">
      {reviews.map((r) => (
        <li class="border border-stone-200 bg-[var(--bg)] p-6">
          <p class="text-[var(--fg)]/90 leading-relaxed">"{r.text}"</p>
          <p class="mt-4 text-sm font-medium text-[var(--accent)]">{r.author}</p>
          <p class="text-sm text-[var(--fg)]/60" aria-label={`${r.rating} sur 5 étoiles`}>
            {"★".repeat(r.rating)}{"☆".repeat(5 - r.rating)}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>
