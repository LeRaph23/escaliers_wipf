---
import { site } from "../config/site";
---

<footer class="border-t border-[#121212]/10 bg-[#F8F9FA]" role="contentinfo">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="flex flex-col gap-10 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="font-semibold text-[#121212]">{site.name}</p>
        <p class="mt-2 text-sm text-[#121212]/70">{site.addressSingleLine}</p>
        <a href={`tel:${site.phone}`} class="mt-2 inline-block text-sm font-medium text-[var(--accent)] hover:underline">
          {site.phoneDisplay}
        </a>
        <a href={`mailto:${site.email}`} class="mt-1 block text-sm text-[#121212]/70 hover:text-[#121212]">
          {site.email}
        </a>
      </div>
      <div class="text-sm text-[#121212]/70">
        <p>Électricien urgence dépannage – Helfrantzkirch, Haut-Rhin. 7j/7.</p>
        <a href="/#contact" class="mt-2 inline-block font-medium text-[var(--accent)] hover:underline">Contact & devis</a>
      </div>
    </div>
    <p class="mt-12 border-t border-[#121212]/10 pt-8 text-left text-xs text-[#121212]/50">
      © {new Date().getFullYear()} {site.name}. Tous droits réservés.
    </p>
  </div>
</footer>
