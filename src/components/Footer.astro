---
import { site, heritage, seoLocal } from "../data/site-content.js";
---

<footer class="border-t border-stone-200 bg-[var(--bg)]" role="contentinfo">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3">
      {/* Coordonnées */}
      <div>
        <h3 class="font-serif text-lg font-semibold text-[var(--fg)]">{site.name}</h3>
        <p class="mt-3 text-sm text-[var(--fg)]/80">{heritage.contact.address}</p>
        <a
          href={`tel:${heritage.contact.phone}`}
          class="mt-2 inline-block text-sm font-medium text-[var(--accent)] hover:underline"
        >
          {heritage.contact.phoneDisplay}
        </a>
        <a
          href={`mailto:${heritage.contact.email}`}
          class="mt-1 block text-sm text-[var(--fg)]/80 hover:text-[var(--fg)] break-all"
        >
          {heritage.contact.email}
        </a>
      </div>

      {/* Zones d'intervention */}
      <div>
        <h3 class="font-serif text-lg font-semibold text-[var(--fg)]">Zones d'intervention</h3>
        <p class="mt-3 text-sm text-[var(--fg)]/80">
          {seoLocal.zones.join(", ")}. Villes : {seoLocal.cities.join(", ")}.
        </p>
        <p class="mt-2 text-sm text-[var(--fg)]/80">
          Suisse : {seoLocal.suisse.join(", ")}.
        </p>
      </div>

      {/* Liens légaux */}
      <div>
        <h3 class="font-serif text-lg font-semibold text-[var(--fg)]">Informations</h3>
        <a href="/mentions-legales" class="mt-3 block text-sm text-[var(--fg)]/80 hover:text-[var(--accent)]">
          Mentions légales
        </a>
        <a href="/#contact" class="mt-2 block text-sm text-[var(--fg)]/80 hover:text-[var(--accent)]">
          Contact & devis
        </a>
      </div>
    </div>

    <p class="mt-12 border-t border-stone-200 pt-8 text-center text-xs text-[var(--fg)]/50">
      © {new Date().getFullYear()} {heritage.companyName}. Tous droits réservés.
    </p>
  </div>
</footer>
