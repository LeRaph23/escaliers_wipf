---
import { heritage } from "../data/site-content.js";
const videoId = heritage.youtubeVideoId?.trim() || "";
---

{videoId ? (
  <section class="border-t border-stone-200 py-24" aria-labelledby="video-heading">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <h2 id="video-heading" class="font-serif text-4xl font-semibold tracking-tight text-[var(--fg)] md:text-5xl text-center">
        Vidéo de présentation
      </h2>
      <div class="mt-10 aspect-video w-full overflow-hidden border border-stone-200">
        <iframe
          src={`https://www.youtube.com/embed/${videoId}`}
          title="Vidéo de présentation - Escaliers Wipf Olivier"
          class="h-full w-full"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        />
      </div>
    </div>
  </section>
) : (
  <section class="border-t border-stone-200 py-16" aria-hidden="true">
    <div class="mx-auto max-w-4xl px-4 text-center text-sm text-[var(--fg)]/50">
      {/* TODO: ajouter l'ID de la vidéo YouTube dans site-content.js → heritage.youtubeVideoId */}
      Vidéo de présentation (à configurer dans site-content.js)
    </div>
  </section>
)}
