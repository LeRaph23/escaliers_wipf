---
import { site } from "../config/site";
---

<section id="contact" class="scroll-reveal scroll-mt-24 border-t border-[#121212]/10 px-4 py-24 sm:px-6 sm:py-32" aria-labelledby="contact-heading">
  <div class="mx-auto max-w-5xl">
    <header class="mb-14 text-left">
      <h2 id="contact-heading" class="text-3xl font-bold tracking-tight text-[#121212] sm:text-4xl">
        Demande de devis
      </h2>
      <p class="mt-4 max-w-2xl text-lg text-[#121212]/70">
        Indiquez votre projet ou votre urgence ; nous vous recontactons rapidement. Dépannage immédiat : <a href={`tel:${site.phone}`} class="font-semibold text-[var(--accent)] hover:underline">{site.phoneDisplay}</a>.
      </p>
    </header>

    <div class="grid gap-10 lg:grid-cols-5 lg:gap-12">
      <div class="rounded-2xl border border-[#121212]/10 bg-[#F8F9FA] p-6 lg:col-span-2">
        <h3 class="text-lg font-semibold text-[#121212]">Nous contacter</h3>
        <p class="mt-3 text-[#121212]/70">{site.addressSingleLine}</p>
        <a href={`tel:${site.phone}`} class="mt-3 inline-block font-semibold text-[var(--accent)] hover:underline">
          {site.phoneDisplay}
        </a>
        <a href={`mailto:${site.email}`} class="mt-2 block break-all text-[#121212]/70 hover:text-[#121212]">
          {site.email}
        </a>
      </div>

      <div class="rounded-2xl border border-[#121212]/10 bg-[#F8F9FA] p-6 sm:p-8 lg:col-span-3">
        <form
          id="contact-form"
          class="space-y-4"
          action="#"
          method="get"
          aria-label="Formulaire de demande de devis"
          data-email={site.email}
        >
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="contact-name" class="block text-sm font-medium text-[#121212]">Nom</label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                autocomplete="name"
                class="mt-1 w-full border border-[#121212]/20 bg-white px-4 py-2.5 text-[#121212] focus:border-[var(--accent)] focus:outline-none focus:ring-1 focus:ring-[var(--accent)]"
              />
            </div>
            <div>
              <label for="contact-email" class="block text-sm font-medium text-[#121212]">Email</label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                autocomplete="email"
                class="mt-1 w-full border border-[#121212]/20 bg-white px-4 py-2.5 text-[#121212] focus:border-[var(--accent)] focus:outline-none focus:ring-1 focus:ring-[var(--accent)]"
              />
            </div>
          </div>
          <div>
            <label for="contact-phone" class="block text-sm font-medium text-[#121212]">Téléphone</label>
            <input
              type="tel"
              id="contact-phone"
              name="phone"
              autocomplete="tel"
              class="mt-1 w-full border border-[#121212]/20 bg-white px-4 py-2.5 text-[#121212] focus:border-[var(--accent)] focus:outline-none focus:ring-1 focus:ring-[var(--accent)]"
            />
          </div>
          <div>
            <label for="contact-subject" class="block text-sm font-medium text-[#121212]">Sujet</label>
            <select
              id="contact-subject"
              name="subject"
              required
              class="mt-1 w-full border border-[#121212]/20 bg-white px-4 py-2.5 text-[#121212] focus:border-[var(--accent)] focus:outline-none focus:ring-1 focus:ring-[var(--accent)]"
            >
              <option value="Demande de devis">Demande de devis</option>
              <option value="Dépannage urgence">Dépannage urgence</option>
              <option value="Renseignement">Renseignement</option>
              <option value="Autre">Autre</option>
            </select>
          </div>
          <div>
            <label for="contact-message" class="block text-sm font-medium text-[#121212]">Message</label>
            <textarea
              id="contact-message"
              name="message"
              required
              rows="4"
              class="mt-1 w-full border border-[#121212]/20 bg-white px-4 py-2.5 text-[#121212] focus:border-[var(--accent)] focus:outline-none focus:ring-1 focus:ring-[var(--accent)]"
              placeholder="Décrivez votre projet ou votre demande..."
            />
          </div>
          <button
            type="submit"
            class="w-full bg-[var(--accent)] px-6 py-4 text-lg font-semibold text-white border border-[var(--accent)] transition hover:bg-[#121212] hover:border-[#121212] focus:outline-none focus:ring-2 focus:ring-[var(--accent)] focus:ring-offset-2"
          >
            Envoyer ma demande de devis
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  document.getElementById("contact-form")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const data = new FormData(form);
    const subject = encodeURIComponent(String(data.get("subject") || "Demande de devis"));
    const body = encodeURIComponent(
      [
        `Nom: ${data.get("name")}`,
        `Email: ${data.get("email")}`,
        `Téléphone: ${data.get("phone")}`,
        "",
        String(data.get("message")),
      ].join("\n")
    );
    const email = form.getAttribute("data-email") || "soselec68@gmail.com";
    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
  });
</script>
