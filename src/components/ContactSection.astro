---
import { heritage } from "../data/site-content.js";
const projectTypes = [
  { value: "escalier-bois", label: "Escalier bois" },
  { value: "metal-inox", label: "Escalier métal / inox" },
  { value: "design", label: "Escalier design" },
  { value: "renovation-habillage", label: "Rénovation / Habillage béton" },
  { value: "garde-corps", label: "Garde-corps" },
  { value: "exterieur", label: "Escalier extérieur" },
  { value: "autre", label: "Autre" },
];
---

<section id="contact" class="scroll-mt-24 border-t border-stone-200 px-4 py-24 sm:px-6 sm:py-32" aria-labelledby="contact-heading">
  <div class="mx-auto max-w-5xl">
    <h2 id="contact-heading" class="font-serif text-4xl font-semibold tracking-tight text-[var(--fg)] sm:text-5xl">
      Demande de devis
    </h2>
    <p class="mt-4 max-w-2xl text-[var(--fg)]/80 leading-relaxed">
      Pour tout renseignement, n'hésitez pas à nous contacter. Réponse rapide au{" "}
      <a href={`tel:${heritage.contact.phone}`} class="font-medium text-[var(--accent)] hover:underline">
        {heritage.contact.phoneDisplay}
      </a>.
    </p>

    <div class="mt-14 grid gap-10 lg:grid-cols-5 lg:gap-12">
      <div class="rounded border border-stone-200 bg-[var(--bg)] p-6 lg:col-span-2">
        <h3 class="font-serif text-lg font-semibold text-[var(--fg)]">Nous contacter</h3>
        <p class="mt-3 text-sm text-[var(--fg)]/80">{heritage.contact.address}</p>
        <a href={`tel:${heritage.contact.phone}`} class="mt-3 inline-block font-medium text-[var(--accent)] hover:underline">
          {heritage.contact.phoneDisplay}
        </a>
        <a href={`mailto:${heritage.contact.email}`} class="mt-2 block break-all text-sm text-[var(--fg)]/80 hover:text-[var(--fg)]">
          {heritage.contact.email}
        </a>
      </div>

      <div class="rounded border border-stone-200 bg-[var(--bg)] p-6 sm:p-8 lg:col-span-3">
        <form
          id="contact-form"
          class="space-y-4"
          action="#"
          method="get"
          aria-label="Formulaire de demande de devis"
          data-email={heritage.contact.email}
        >
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="contact-nom" class="block text-sm font-medium text-[var(--fg)]">Nom *</label>
              <input
                type="text"
                id="contact-nom"
                name="nom"
                required
                autocomplete="family-name"
                class="mt-1 w-full border border-stone-200 bg-white px-4 py-2.5 text-[var(--fg)] focus:border-[var(--accent)] focus:outline-none focus:ring-1 focus:ring-[var(--accent)]"
              />
            </div>
            <div>
              <label for="contact-prenom" class="block text-sm font-medium text-[var(--fg)]">Prénom *</label>
              <input
                type="text"
                id="contact-prenom"
                name="prenom"
                required
                autocomplete="given-name"
                class="mt-1 w-full border border-stone-200 bg-white px-4 py-2.5 text-[var(--fg)] focus:border-[var(--accent)] focus:outline-none focus:ring-1 focus:ring-[var(--accent)]"
              />
            </div>
          </div>
          <div>
            <label for="contact-phone" class="block text-sm font-medium text-[var(--fg)]">Téléphone *</label>
            <input
              type="tel"
              id="contact-phone"
              name="telephone"
              required
              autocomplete="tel"
              class="mt-1 w-full border border-stone-200 bg-white px-4 py-2.5 text-[var(--fg)] focus:border-[var(--accent)] focus:outline-none focus:ring-1 focus:ring-[var(--accent)]"
            />
          </div>
          <div>
            <label for="contact-localite" class="block text-sm font-medium text-[var(--fg)]">Localité *</label>
            <input
              type="text"
              id="contact-localite"
              name="localite"
              required
              autocomplete="address-level2"
              class="mt-1 w-full border border-stone-200 bg-white px-4 py-2.5 text-[var(--fg)] focus:border-[var(--accent)] focus:outline-none focus:ring-1 focus:ring-[var(--accent)]"
            />
          </div>
          <div>
            <label for="contact-type" class="block text-sm font-medium text-[var(--fg)]">Type de projet *</label>
            <select
              id="contact-type"
              name="type_projet"
              required
              class="mt-1 w-full border border-stone-200 bg-white px-4 py-2.5 text-[var(--fg)] focus:border-[var(--accent)] focus:outline-none focus:ring-1 focus:ring-[var(--accent)]"
            >
              <option value="">Choisir…</option>
              {projectTypes.map((opt) => (
                <option value={opt.value}>{opt.label}</option>
              ))}
            </select>
          </div>
          <div>
            <label for="contact-message" class="block text-sm font-medium text-[var(--fg)]">Message *</label>
            <textarea
              id="contact-message"
              name="message"
              required
              rows="4"
              class="mt-1 w-full border border-stone-200 bg-white px-4 py-2.5 text-[var(--fg)] focus:border-[var(--accent)] focus:outline-none focus:ring-1 focus:ring-[var(--accent)]"
              placeholder="Décrivez votre projet..."
            />
          </div>
          <p class="text-xs text-[var(--fg)]/60">
            En soumettant ce formulaire, j'accepte que les informations saisies soient utilisées pour ma demande.{" "}
            <a href="/mentions-legales" class="text-[var(--accent)] hover:underline">Mentions légales et politique de confidentialité</a>.
          </p>
          <button
            type="submit"
            class="w-full bg-[var(--accent)] px-6 py-4 text-base font-medium text-white border border-[var(--accent)] transition hover:bg-[#1C1917] hover:border-[#1C1917] focus:outline-none focus:ring-2 focus:ring-[var(--accent)] focus:ring-offset-2"
          >
            Envoyer ma demande de devis
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  document.getElementById("contact-form")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const data = new FormData(form);
    const subject = encodeURIComponent("Demande de devis - " + (data.get("type_projet") || ""));
    const body = encodeURIComponent(
      [
        `Nom: ${data.get("nom")} ${data.get("prenom")}`,
        `Téléphone: ${data.get("telephone")}`,
        `Localité: ${data.get("localite")}`,
        `Type de projet: ${data.get("type_projet")}`,
        "",
        String(data.get("message")),
      ].join("\n")
    );
    const email = form.getAttribute("data-email") || "";
    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
  });
</script>
