---
import { site, heritage } from "../data/site-content.js";
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 border-b border-stone-200/0 bg-[#FAF9F6]/80 transition-[background-color,border-color] duration-300"
  role="banner"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <a href="/" class="font-serif text-xl font-semibold tracking-tight text-[var(--fg)] hover:text-[var(--accent)]" aria-label={`${site.name} – Accueil`}>
      {site.name}
    </a>
    <nav class="flex items-center gap-6 sm:gap-8" aria-label="Navigation principale">
      <a href="/#catalogue" class="text-sm text-[var(--fg)]/80 hover:text-[var(--fg)]">Réalisations</a>
      <a href="/#galerie" class="text-sm text-[var(--fg)]/80 hover:text-[var(--fg)]">Galerie</a>
      <a href="/#avis" class="text-sm text-[var(--fg)]/80 hover:text-[var(--fg)]">Avis</a>
      <a href="/#contact" class="text-sm text-[var(--fg)]/80 hover:text-[var(--fg)]">Contact</a>

      <!-- Sélecteur de langue FR / DE -->
      <div class="flex items-center gap-1 border-l border-stone-200 pl-4">
        <a href="#" class="px-2 py-1 text-sm font-medium text-[var(--accent)]" aria-current="page" aria-label="Français">FR</a>
        <span class="text-stone-300">|</span>
        <a href="#" class="px-2 py-1 text-sm text-[var(--fg)]/60 hover:text-[var(--fg)]" aria-label="Deutsch">DE</a>
      </div>

      <a
        href="/#contact"
        class="bg-[var(--accent)] px-5 py-2.5 text-sm font-medium text-white border border-[var(--accent)] transition hover:bg-[#1C1917] hover:border-[#1C1917] focus:outline-none focus:ring-2 focus:ring-[var(--accent)] focus:ring-offset-2"
      >
        Devis
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var header = document.getElementById("site-header");
    if (!header) return;
    function update() {
      if (window.scrollY > 20) {
        header.classList.add("!border-stone-200", "bg-[#FAF9F6]/95", "backdrop-blur-md");
      } else {
        header.classList.remove("!border-stone-200", "bg-[#FAF9F6]/95", "backdrop-blur-md");
      }
    }
    window.addEventListener("scroll", update, { passive: true });
    update();
  })();
</script>
